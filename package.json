{
  "name": "cookbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-config.mjs --optional && tsc --noEmit && vite build",
    "build:reminders": "node scripts/build-reminders-shortcut.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:database": "bash scripts/test-database.sh",
    "check": "tsc --noEmit",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
