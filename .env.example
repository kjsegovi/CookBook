# Public browser configuration. Never put service-role keys or passwords here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional Edge Function region override, only after comparing live timings.
VITE_SUPABASE_FUNCTION_REGION=

# The hosted website address, used for password reset links and the bookmarklet
# when CookBook runs as a desktop or phone app. Leave empty for the website alone.
VITE_PUBLIC_APP_URL=
