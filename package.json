{
  "name": "cookbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-config.mjs --optional && tsc --noEmit && vite build",
    "build:reminders": "node scripts/build-reminders-shortcut.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "vectors:export": "node scripts/export-command-vectors.mjs",
    "test:database": "bash scripts/test-database.sh",
    "check": "tsc --noEmit",
    "verify:pages": "node scripts/verify-pages.mjs",
    "build:share-shortcut": "node scripts/build-share-shortcut.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
